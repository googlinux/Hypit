<?svml using="@hypit/svs@1"?>
<sheet version="1">
  film.main { background: #101014; }
  text.title {
    stack-order: 10; size: 62; line-height: 1.15;
    align: center; block-align: center; inline-size: fixed; block-size: fixed;
    wrap: word; overflow: visible;
  }
  text.caption {
    stack-order: 11; size: 23; line-height: 1.4;
    align: center; block-align: center; inline-size: fixed; block-size: fixed;
    wrap: word; overflow: visible;
  }
</sheet>
